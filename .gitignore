# Dependencias
node_modules/

# Variables de entorno y credenciales (NUNCA SUBIR A GITHUB)
.env
.env.local
.env.*.local
*.env

# Archivos de medios generados en ejecuciones
outputs/audio/*
!outputs/audio/.gitkeep
outputs/media/*
!outputs/media/.gitkeep
outputs/video/*
!outputs/video/.gitkeep
outputs/temp/*
!outputs/temp/.gitkeep

# Logs y depuración
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
outputs/key.txt

# Archivos temporales de pruebas
outputs/_*
