# Clave de API de Google Gemini (Gratis en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Clave de API de la NASA (Opcional, 'DEMO_KEY' funciona de serie)
NASA_API_KEY=DEMO_KEY

# Claves de stock de video. Sin al menos una de las dos, los videos se generan
# solo con material de la NASA y el resultado es muy pobre.
# Pexels: https://www.pexels.com/api/  |  Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=tu_api_key_de_pexels_aqui
PIXABAY_API_KEY=tu_api_key_de_pixabay_aqui

# Nombre del Canal / Marca
BRAND_NAME=CIENCIA COOL
